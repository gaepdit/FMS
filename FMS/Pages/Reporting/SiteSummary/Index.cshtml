@page
@using FMS.Domain.Dto
@using FMS.Domain.Entities.Users
@model FMS.Pages.Reporting.SiteSummary.IndexModel

@{
    ViewData["Title"] = $"Site Summary Report";
}

<a asp-page="../Index">← Back to Reports</a>
<div class="container-fluid bg-light-subtle p-3 rounded-3">
    <h1>
        @ViewData["Title"]
    </h1>
    <form method="get" asp-fragment="SearchResults">
        <div class="row">
            <p>
                Choose from the following lists to narrow report list, or leave blank for all reports.
            </p>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-4">
                <label asp-for="Spec.FacilityNumber"></label>
                <input asp-for="Spec.FacilityNumber" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="Spec.OrganizationalUnitId"></label>
                <select asp-for="Spec.OrganizationalUnitId" asp-items="Model.OrganizationalUnits" class="form-select">
                    <option value=""></option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="Spec.ComplianceOfficerId"></label>
                <select asp-for="Spec.ComplianceOfficerId" asp-items="Model.ComplianceOfficers" class="form-select">
                    <option value=""></option>
                </select>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <label asp-for="Spec.AdditionalOrganizationalUnitId"></label>
                <select asp-for="Spec.AdditionalOrganizationalUnitId" asp-items="Model.AddlOrgUnits" class="form-select">
                    <option value=""></option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="Spec.CountyId"></label>
                <select asp-for="Spec.CountyId" asp-items="Model.Counties" class="form-select">
                    <option value=""></option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="Spec.LocationClassId"></label>
                <select asp-for="Spec.LocationClassId" asp-items="Model.LocationClasses" class="form-select">
                    <option value=""></option>
                </select>
            </div>
        </div>
        <br />
        <div class="row text-center">
            <div class="col-md-6">
                <div class="row">
                    <p>
                        Choose Sorting Order
                    </p>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <label>
                            @Html.RadioButtonFor(m => m.Spec.SortBy, SiteSummaryQuerySpec.SiteSummarySortBy.Facility_Number)
                            Facility Number
                        </label>
                    </div>
                    <div class="col-md-3">
                        <label>
                            @Html.RadioButtonFor(m => m.Spec.SortBy, SiteSummaryQuerySpec.SiteSummarySortBy.Facility_Name)
                            Facility Name
                        </label>
                    </div>
                    <div class="col-md-3">
                        <label>
                            @Html.RadioButtonFor(m => m.Spec.SortBy, SiteSummaryQuerySpec.SiteSummarySortBy.County)
                            County
                        </label>
                    </div>
                    <div class="col-md-3">
                        <label>
                            @Html.RadioButtonFor(m => m.Spec.SortBy, SiteSummaryQuerySpec.SiteSummarySortBy.Class)
                            Class
                        </label>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row">
                    <p>
                        Choose Additional Org. Unit Inclusions/Exclusions
                    </p>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <label>
                            @Html.RadioButtonFor(m => m.Spec.Include, SiteSummaryQuerySpec.SiteSummaryAddlOrgUnitInclusion.All)
                            Include All
                        </label>
                    </div>
                    <div class="col-md-4">
                        <label>
                            @Html.RadioButtonFor(m => m.Spec.Include, SiteSummaryQuerySpec.SiteSummaryAddlOrgUnitInclusion.Exclude)
                            Exclude w/ Add'l
                        </label>
                    </div>
                    <div class="col-md-4">
                        <label>
                            @Html.RadioButtonFor(m => m.Spec.Include, SiteSummaryQuerySpec.SiteSummaryAddlOrgUnitInclusion.Include)
                            Only w/ Add'l
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-md-4">
                <div class="form-check">
                    <input asp-for="Spec.ShowHeader" />
                    <label asp-for="Spec.ShowHeader" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-check">
                    <input asp-for="Spec.IsLandFill" />
                    <label asp-for="Spec.IsLandFill" class="form-check-label" disabled="true"></label>
                </div>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-md-6">
                <input type="hidden" name="handler" value="Preview" />
                <button id="PreviewButton" type="submit" class="btn btn-primary me-2">Preview Report List</button>
                <a asp-page="./Index" class="btn btn-outline-secondary col-sm-3 col-md-2">Clear</a>
            </div>
        </div>
    </form>
</div>
@if (Model.ShowResults)
{
    <div id="SearchResults" class="container-fluid bg-light-subtle p-3 rounded-3">
        <div class="row">
            <div class="col-1">
                <h3>Results</h3>
            </div>
            @if (Model.SummaryList.Count > 0)
            {
                <div class="col-2 d-print-none ms-2">
                    <a asp-page="Report" asp-all-route-data="Model.Spec.AsRouteValues()" target="_blank"
                       class="btn btn-sm btn-primary icon-link">
                        <svg class="bi">
                            <use href="@Url.Content("~/images/app-icons.svg")#app-icon-printer-fill"></use>
                        </svg>
                        Export/Print Reports
                    </a>
                </div>
            }
            @if (Model.SummaryList.Count > 0)
            {
                <div class="col-auto text-md-end align-text-bottom mb-1">
                    Total results: @Html.DisplayFor(m => Model.SummaryList.Count)
                </div>
            }
        </div>
    </div>
    <div class="container-fluid bg-light-subtle p-3 rounded-3">
        @if (Model.SummaryList.Count > 0)
        {
            <form method="post">
                <input type="hidden" asp-for="Spec.AdditionalOrganizationalUnitId" />
                <input type="hidden" asp-for="Spec.ComplianceOfficerId" />
                <input type="hidden" asp-for="Spec.CountyId" />
                <input type="hidden" asp-for="Spec.FacilityNumber" />
                <input type="hidden" asp-for="Spec.IsLandFill" />
                <input type="hidden" asp-for="Spec.LocationClassId" />
                <input type="hidden" asp-for="Spec.OrganizationalUnitId" />
                <input type="hidden" asp-for="Spec.SortBy" />
                <div class="row">
                    <div class="col-5">
                        <h5>Lists of URLs to Site Summary Reports</h5>
                    </div>
                    <div class="col-auto align-right d-print-none ms-2">
                        <button id="ExportButton"
                                asp-page-handler="ExportButton"
                                class="btn btn-sm btn-outline-success mb-1">
                            Export Site Summary List to Excel
                        </button>
                    </div>
                    <div class="col-auto align-right d-print-none ms-2">
                        <a asp-page="SiteSummaryList" asp-all-route-data="Model.Spec.AsRouteValues()" target="_blank"
                           class="btn btn-sm btn-outline-success icon-link">
                            <svg class="bi">
                                <use href="@Url.Content("~/images/app-icons.svg")#app-icon-printer-fill"></use>
                            </svg>
                            Export/Print List
                        </a>
                    </div>
                    @if (User.IsInRole(UserRoles.SiteMaintenance))
                    {
                        <div class="col-auto align-right d-print-none ms-2">
                            <button id="ExportEsriButton"
                                    asp-page-handler="ExportEsriButton"
                                    class="btn btn-sm btn-outline-success mb-1">
                                Export List to Excel for ESRI
                            </button>
                        </div>
                    }
                </div>
            </form>
        }
    </div>
    <div class="container-fluid bg-light-subtle p-3 rounded-3">
        @if (Model.SummaryList.Count == 0)
        {
            <p class="lead text-info">No matching results found.</p>
        }
        else
        {
            <table class="table" aria-label="Facility search results">
                <thead class="thead-dark position-sticky top-0">
                    <tr>
                        <th scope="col" class="text-center">HSI Number</th>
                        <th scope="col">Facility Name <span class="text-muted">(click for individual report)</span></th>
                        <th scope="col">Organizational Unit</th>
                        <th scope="col">Compliance Officer</th>
                        <th scope="col">County</th>
                        <th scope="col">Class</th>
                        <th scope="col">Latitude/Longitude</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.SummaryList)
                    {
                        <tr class="@(!item.Active ? "table-warning" : "")">
                            <td>
                                <a asp-page="/Facilities/Details" asp-route-id="@item.Id" target="_blank" class="btn @(item.Active ? "btn-outline-info" : "btn-outline-secondary") btn-sm">
                                    @Html.DisplayFor(m => item.FacilityNumber, "StringOrNone")
                                </a>
                            </td>
                            <td><a href="@Model.SiteSummaryURL@item.FacilityNumber" target="_blank">@Html.DisplayFor(m => item.Name, "StringOrNone")</a></td>
                            <td>@Html.DisplayFor(m => item.OrganizationalUnit.Name, "StringOrNone")</td>
                            <td>@Html.DisplayFor(m => item.ComplianceOfficer.Name, "StringOrNone")</td>
                            <td>@Html.DisplayFor(m => item.County.Name, "StringOrNone")</td>
                            @if (item.LocationClass == null)
                            {
                                <td>None</td>
                            }
                            else
                            {
                                <td>@Html.DisplayFor(m => item.LocationClass.Name, "StringOrNone")</td>
                            }
                            <td>
                                @Html.DisplayFor(m => item.Latitude, "DecimalOrNone")/@Html.DisplayFor(m => item.Longitude, "DecimalOrNone")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}
