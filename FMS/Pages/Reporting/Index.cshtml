@page
@using FMS.Pages.Reporting
@model FMS.Pages.Reporting.IndexModel
@{
    ViewData["Title"] = $"Reports";
}
<h1>@ViewData["Title"]</h1>

<div class="container-fluid bg-light-subtle p-3 rounded-3">
    <p class="lead">Select a Report from the list</p>
    <ul class="list-group">
        <li class="list-group-item list-group-item-action">
            <a class="nav-link" asp-page="AssignmentList/Index">@ReportingOptions.AssignmentList</a>
        </li>
        <li class="list-group-item list-group-item-action">
            <a class="nav-link" asp-page="Delisted/Index">@ReportingOptions.Delisted</a>
        </li>
        <li class="list-group-item list-group-item-action">
            <a class="nav-link" asp-page="Events/Index">@ReportingOptions.Events</a>
        </li>
        <li class="list-group-item list-group-item-action">
            <a class="nav-link" asp-page="PAF/Index">@ReportingOptions.PAF</a>
        </li>
        <li class="list-group-item list-group-item-action">
            <a class="nav-link" asp-page="HSISiteLists/Index">@ReportingOptions.HSISiteLists</a>
        </li>
        <li class="list-group-item list-group-item-action">
            <a class="nav-link" asp-page="AbndInac/Index">@ReportingOptions.AbndInac</a>
        </li>
        <li class="list-group-item list-group-item-action">
            <a class="nav-link" asp-page="SiteSummary/Index">@ReportingOptions.SiteSummary</a>
        </li>
    </ul>
</div>