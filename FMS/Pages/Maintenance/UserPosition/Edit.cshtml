@page "{id:Guid?}"
@using FMS.Pages.Maintenance
@model FMS.Pages.Maintenance.UserPosition.EditModel

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@{
    ViewData["Title"] = $"Edit {MaintenanceOptions.UserPosition}: {Model.UserPosition.Name}";
}

<div class="container bg-light-subtle py-3 rounded-3 mt-3">
    <h1>
        @ViewData["Title"]
        @if (!Model.UserPosition.Active)
        {
            <span class="text-muted">(Removed)</span>
        }
    </h1>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="UserPosition.Active" />
        <input type="hidden" asp-for="Id" />
        <div class="row mb-3">
            <div class="col-md-3">
                <label asp-for="UserPosition.Name">@MaintenanceOptions.UserPosition <span class="text-danger">*</span></label>
                <input asp-for="UserPosition.Name" class="form-control" aria-describedby="FileIdHelpBlock" />
                <span asp-validation-for="UserPosition.Name" class="text-danger"></span>
            </div>
            <div class="col-md">
                <label asp-for="UserPosition.Description">@MaintenanceOptions.UserPosition Description <span class="text-danger">*</span></label>
                <input asp-for="UserPosition.Description" class="form-control" />
                <span asp-validation-for="UserPosition.Description" class="text-danger"></span>
            </div>
        </div>
        <hr />
        <p class="text-danger">* denotes a required field</p>
        <button type="submit" class="btn btn-primary col-sm-3 mb-3 mb-sm-0">Save Changes</button>
        <a asp-page="Index" class="btn btn-outline-secondary col-md-2" asp-route-handler="select"
           asp-route-MaintenanceSelection="@MaintenanceOptions.UserPosition">
            Cancel
        </a>
    </form>
</div>
