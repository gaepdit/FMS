@page "{id:Guid?}"
@using FMS.Pages.Maintenance
@model FMS.Pages.Maintenance.OrganizationalUnit.EditModel

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@{
    ViewData["Title"] = $"Edit {MaintenanceOptions.OrganizationalUnit}: {Model.OrganizationalUnit.Name}";
}

<div class="container bg-light-subtle py-3 rounded-3 mt-3">
    <h1>
        @ViewData["Title"]
        @if (!Model.OrganizationalUnit.Active)
        {
            <span class="text-muted">(Removed)</span>
        }
    </h1>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="OrganizationalUnit.Active" />
        <input type="hidden" asp-for="Id" />
        <div class="row mb-3">
            <div class="col-md-8">
                <label asp-for="OrganizationalUnit.Name">@MaintenanceOptions.OrganizationalUnit Name <span class="text-danger">*</span></label>
                <input asp-for="OrganizationalUnit.Name" class="form-control" />
                <span asp-validation-for="OrganizationalUnit.Name" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="UserProgramId"></label>
                <select asp-for="UserProgramId" asp-items="Model.UserPrograms" class="form-select">
                    <option value=""></option>
                </select>
            </div>
        </div>
        <hr />
        <p class="text-danger">* denotes a required field</p>
        <button type="submit" class="btn btn-primary col-sm-3 mb-3 mb-sm-0">Save Changes</button>
        <a asp-page="Index" class="btn btn-outline-secondary col-md-2" asp-route-handler="select"
           asp-route-MaintenanceSelection="@MaintenanceOptions.OrganizationalUnit">
            Cancel
        </a>
    </form>
</div>