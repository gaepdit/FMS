@page
@using FMS.Pages.Maintenance
@model FMS.Pages.Maintenance.IndexModel
@{
    ViewData["Title"] = $"Site Maintenance";
}
<h1>@ViewData["Title"]</h1>

<p class="lead">Select a drop-down list to edit.</p>

<div class="container-fluid bg-light-subtle p-3 rounded-3">
    <p class="lead">Facility and User drop-down menu list</p>
    <ul class="list-group">
        <li class="list-group-item list-group-item-action">
            <a class="nav-link" asp-page="BudgetCode/Index">@MaintenanceOptions.BudgetCode</a>
        </li>
        <li class="list-group-item list-group-item-action">
            <a class="nav-link" asp-page="ComplianceOfficer/Index">@MaintenanceOptions.ComplianceOfficer</a>
        </li>
        <li class="list-group-item list-group-item-action">
            <a class="nav-link" asp-page="FacilityStatus/Index">@MaintenanceOptions.FacilityStatus</a>
        </li>
        <li class="list-group-item list-group-item-action">
            <a class="nav-link" asp-page="FacilityType/Index">@MaintenanceOptions.FacilityType</a>
        </li>
        <li class="list-group-item list-group-item-action">
            <a class="nav-link" asp-page="OrganizationalUnit/Index">@MaintenanceOptions.OrganizationalUnit</a>
        </li>
        <li class="list-group-item list-group-item-action">
            <a class="nav-link" asp-page="UserPosition/Index">@MaintenanceOptions.UserPosition</a>
        </li>
        <li class="list-group-item list-group-item-action">
            <a class="nav-link" asp-page="UserProgram/Index">@MaintenanceOptions.UserProgram</a>
        </li>
    </ul>
</div>
<br />
