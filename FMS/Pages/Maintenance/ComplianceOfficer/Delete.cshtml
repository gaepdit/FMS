@page
@model FMS.Pages.Maintenance.ComplianceOfficer.DeleteModel

@{
    ViewData["Title"] = $"Delete Compliance Officer: {Model.ComplianceOfficer.DisplayName}";
}

<div class="container bg-light-subtle p-3 m-1 rounded-3">
    <h1>
        <em>Confirm</em> @ViewData["Title"]
    </h1>
    <p class="lead text-danger font-weight-medium">Are you sure you want to delete this Compliance Officer?</p>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ComplianceOfficer.DisplayName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ComplianceOfficer.DisplayName, "StringOrNone")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ComplianceOfficer.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ComplianceOfficer.Email, "StringOrNone")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ComplianceOfficer.UserInfo.UserProgram)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ComplianceOfficer.UserInfo.UserProgram.Name, "StringOrNone")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ComplianceOfficer.UserInfo.UserUnit)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ComplianceOfficer.UserInfo.UserUnit.Name, "StringOrNone")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ComplianceOfficer.UserInfo.UserPosition)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ComplianceOfficer.UserInfo.UserPosition.Name, "StringOrNone")
        </dd>
    </dl>
</div>
@if (!Model.HasFacilities)
{
    <div class="container bg-light-subtle p-3 m-1 rounded-3">
        <div class="alert alert-warning" role="alert">
            <h4 class="alert-heading">No associated facilities found.</h4>
            <p>This Compliance Officer is not associated with any facilities.</p>
        </div>
    </div>
}
else
{
    <div class="container bg-light-subtle p-3 m-1 rounded-3">
        <h3>Facilities where they are Compliance Officer</h3>
        <div class="row justify-content-evenly">
            <table class="table" aria-label="Facility List">
                <thead class="thead-light position-sticky top-0">
                    <tr>
                        <th scope="col" class="col">Facility Number</th>
                        <th scope="col" class="col">Facility Name</th>
                        <th scope="col" class="col">Type</th>
                        <th scope="col" class="col">Org. Unit</th>
                        <th scope="col" class="col">Status</th>
                        <th scope="col" class="col">Compliance Officer</th>
                        <th scope="col" class="col">County</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.FacilityDetailList.Select(f => f).Where(f => f.ComplianceOfficer != null &&
                    f.ComplianceOfficer.Id == Model.Id).Distinct().Count() > 0)
                    {
                        @foreach (var facility in Model.FacilityDetailList.Select(f => f).Where(f => f.ComplianceOfficer != null &&
                        f.ComplianceOfficer.Id == Model.Id).Distinct())
                        {

                            <tr>
                                <td>
                                    <a asp-page="/Facilities/Details" asp-route-id="@facility.Id" target="_blank" class="btn @(facility.Active ? "btn-outline-info" : "btn-outline-secondary") btn-sm">
                                        @Html.DisplayFor(m => facility.FacilityNumber, "StringOrNone")
                                    </a>
                                </td>
                                <td>@Html.DisplayFor(m => facility.Name, "StringOrNone")</td>
                                <td>@Html.DisplayFor(m => facility.FacilityType.Name, "StringOrNone")</td>
                                <td>@Html.DisplayFor(m => facility.OrganizationalUnit.Name, "StringOrNone")</td>
                                <td>@Html.DisplayFor(m => facility.FacilityStatus.Name, "StringOrNone")</td>
                                <td>@Html.DisplayFor(m => facility.ComplianceOfficer.Name, "StringOrNone")</td>
                                <td>@Html.DisplayFor(m => facility.County.Name, "StringOrNone")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">No associated facilities found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="container bg-light-subtle p-3 m-1 rounded-3">
        <h3>Facilities where they are Geologist</h3>
        <div class="row justify-content-evenly">
            <table class="table" aria-label="Facility List">
                <thead class="thead-light position-sticky top-0">
                    <tr>
                        <th scope="col" class="col">Facility Number</th>
                        <th scope="col" class="col">Facility Name</th>
                        <th scope="col" class="col">Type</th>
                        <th scope="col" class="col">Org. Unit</th>
                        <th scope="col" class="col">Status</th>
                        <th scope="col" class="col">Geologist</th>
                        <th scope="col" class="col">County</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.FacilityDetailList.Select(f => f).Where(f => f.HsrpFacilityPropertyDetails != null &&
                    f.HsrpFacilityPropertyDetails.ComplianceOfficer != null &&
                    f.HsrpFacilityPropertyDetails.ComplianceOfficer.Id == Model.Id).Distinct().Count() > 0)
                    {
                        @foreach (var facility in Model.FacilityDetailList.Select(f => f).Where(f => f.HsrpFacilityPropertyDetails != null &&
                        f.HsrpFacilityPropertyDetails.ComplianceOfficer != null &&
                        f.HsrpFacilityPropertyDetails.ComplianceOfficer.Id == Model.Id).Distinct())
                        {

                            <tr>
                                <td>
                                    <a asp-page="/Facilities/Details"
                                       asp-route-id="@facility.Id"
                                       asp-route-tab="HSIProperties"
                                       asp-fragment="TabPages"
                                       target="_blank"
                                       class="btn @(facility.Active ? "btn-outline-info" : "btn-outline-secondary") btn-sm">
                                        @Html.DisplayFor(m => facility.FacilityNumber, "StringOrNone")
                                    </a>
                                </td>
                                <td>@Html.DisplayFor(m => facility.Name, "StringOrNone")</td>
                                <td>@Html.DisplayFor(m => facility.FacilityType.Name, "StringOrNone")</td>
                                <td>@Html.DisplayFor(m => facility.OrganizationalUnit.Name, "StringOrNone")</td>
                                <td>@Html.DisplayFor(m => facility.FacilityStatus.Name, "StringOrNone")</td>
                                <td>@Html.DisplayFor(m => facility.HsrpFacilityPropertyDetails.ComplianceOfficer.Name, "StringOrNone")</td>
                                <td>@Html.DisplayFor(m => facility.County.Name, "StringOrNone")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">No associated facilities found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="container bg-light-subtle p-3 m-1 rounded-3">
        <h3>Facilities where they created Events</h3>
        <div class="row justify-content-evenly">
            <table class="table" aria-label="Facility List">
                <thead class="thead-light position-sticky top-0">
                    <tr>
                        <th scope="col" class="col">Facility Number</th>
                        <th scope="col" class="col">Facility Name</th>
                        <th scope="col" class="col">Type</th>
                        <th scope="col" class="col">Org. Unit</th>
                        <th scope="col" class="col">Status</th>
                        <th scope="col" class="col">Event Done By</th>
                        <th scope="col" class="col">County</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.FacilityDetailList.Select(f => f).Where(f => f.Events != null &
                    f.Events.Count > 0 &&
                    f.Events.Any(e => e.ComplianceOfficer != null &&
                    e.ComplianceOfficer.Id == Model.Id)).Distinct().Count() > 0)
                    {
                        @foreach (var facility in Model.FacilityDetailList.Select(f => f).Where(f => f.Events != null &&
                        f.Events.Count > 0 &&
                        f.Events.Any(e => e.ComplianceOfficer != null &&
                        e.ComplianceOfficer.Id == Model.Id)).Distinct())
                        {

                            <tr>
                                <td>
                                    <a asp-page="/Facilities/Details"
                                       asp-route-id="@facility.Id"
                                       asp-route-tab="Events"
                                       asp-fragment="TabPages"
                                       target="_blank"
                                       class="btn @(facility.Active ? "btn-outline-info" : "btn-outline-secondary") btn-sm">
                                        @Html.DisplayFor(m => facility.FacilityNumber, "StringOrNone")
                                    </a>
                                </td>
                                <td>@Html.DisplayFor(m => facility.Name, "StringOrNone")</td>
                                <td>@Html.DisplayFor(m => facility.FacilityType.Name, "StringOrNone")</td>
                                <td>@Html.DisplayFor(m => facility.OrganizationalUnit.Name, "StringOrNone")</td>
                                <td>@Html.DisplayFor(m => facility.FacilityStatus.Name, "StringOrNone")</td>
                                <td>@Html.DisplayFor(m => facility.Events.FirstOrDefault().ComplianceOfficer.Name, "StringOrNone")</td>
                                <td>@Html.DisplayFor(m => facility.County.Name, "StringOrNone")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">No associated facilities found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
<div class="container bg-light-subtle p-3 m-1 rounded-3">
    <form method="post">
        <input asp-for="Id" type="hidden" />
        <button type="submit" class="btn btn-danger col-sm-3 mb-3 mb-sm-0">Delete Compliance Officer</button>
        <a asp-page="./Index" class="btn btn-outline-secondary col-sm-3 col-md-2">Cancel</a>
    </form>
</div>
