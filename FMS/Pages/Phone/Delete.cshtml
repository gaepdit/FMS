@page
@model FMS.Pages.Phone.DeleteModel
@{
    ViewData["Title"] = $"Delete Phone";
}

<h1><em>Confirm</em> @ViewData["Title"]</h1>
<p class="lead text-danger font-weight-medium">Are you sure you want to delete this Phone?<br /><strong>This action cannot be undone.</strong></p>
<div class="container bg-light-subtle p-3 m-1 rounded-3">
    <form method="post">
        <div class="row justify-content-evenly">
            <table class="table table-sm" aria-label="Phones">
                <thead class="thead-light">
                    <tr>
                        <th scope="col">Contact Name</th>
                        <th scope="col">Phone Type</th>
                        <th scope="col">Number</th>
                        <th class="text-center" scope="col">Active</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="@(!Model.PhoneDetail.Active ? "text-muted table-warning" : "") ">
                        <td>@Model.ContactDetail.GivenName&nbsp;@Model.ContactDetail.FamilyName</td>
                        <td>@Model.PhoneDetail.PhoneType</td>
                        <td><a href=@Model.PhoneDetail.GetTelTo()>@Model.PhoneDetail.Number</a></td>
                        <td class="text-center">@Html.DisplayFor(m => Model.PhoneDetail.Active, "BoolYesNo")</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <input type="hidden" asp-for="PhoneDetail.Id" />
        <input type="hidden" asp-for="FacilityId" />
        <button type="submit" class="btn btn-danger col-sm-4 col-md-3 mb-3 mb-sm-0">Confirm Delete</button>
        <a asp-page="../Facilities/Details"
           asp-route-Id="@Model.FacilityId"
           asp-route-tab="Contacts"
           asp-fragment="TabPages"
           class="btn btn-outline-secondary col-md-2">
            Cancel
        </a>
    </form>
</div>