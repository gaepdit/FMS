@page
@using FMS.Domain.Entities.Users
@model FMS.Pages.Account.IndexModel
@{
    ViewData["Title"] = "Account Profile";
}

@section Scripts {
    <script src="~/js/formDetails.js"></script>
}

<h1>@ViewData["Title"]</h1>
<partial name="_AlertPartial" for="Message" id="alert" />
<hr />

<h2>@Model.CurrentUser.DisplayName</h2>
<p>@Model.CurrentUser.Email</p>

<div class="p-3 rounded-3 bg-light-subtle">
    <form method="get">
        <div class="mb-3 row">
            <div class="col-md-4">
                <label asp-for="CurrentUser.UserProgram"></label>
                <select asp-for="CurrentUser.UserProgram" asp-items="Model.UserPrograms" class="form-select">
                    <option value=""></option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="CurrentUser.UserUnit"></label>
                <select asp-for="CurrentUser.UserUnit" asp-items="Model.UserUnits" class="form-select">
                    <option value=""></option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="CurrentUser.UserPosition"></label>
                <select asp-for="CurrentUser.UserPosition" asp-items="Model.UserPositions" class="form-select">
                    <option value=""></option>
                </select>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-md-6">
                <input type="hidden" name="handler" value="UserDesignation" />
                <button id="UserDesignationButton" type="submit" class="btn btn-primary me-2">Update User Designations</button>
                <a asp-page="./Index" class="btn btn-outline-secondary col-sm-3 col-md-2">Clear</a>
            </div>
        </div>
    </form>
</div>

@if (Model.Roles != null && Model.Roles.Count > 0)
{
    <h3>Roles</h3>
    <dl>
        @foreach (var role in Model.Roles)
        {
            <dt>@UserRoles.DisplayName(role)</dt>
            <dd>
                <small class="text-muted">@UserRoles.Description(role)</small>
            </dd>
        }
    </dl>
}

<form asp-page="./Logout" asp-route-returnUrl="@Url.Page("/")" method="post">
    <button type="submit" class="btn btn-danger">Sign out</button>
</form>