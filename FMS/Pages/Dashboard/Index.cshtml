                                                </td>
                                                <td>
                                                    @Html.DisplayFor(m => item.FacilityName, "StringOrNone")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(m => item.EventType.Name, "StringOrNone")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(m => item.ActionTaken.Name, "StringOrNone")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(m => item.StartDate, "DateOrNone")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(m => item.DueDate, "DateOrNone")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(m => item.CompletionDate, "DateOrNone")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(m => item.OrganizationalUnit.Name, "StringOrNone")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(m => item.Comment, "StringOrNone")
                                                </td>
                                                @if (User.IsInRole(UserRoles.FileEditor) || User.IsInRole(UserRoles.ComplianceOfficer))
                                                {
                                                    <td>
                                                        <a asp-page="/Event/Edit"
                                                           asp-route-id="@item.Id"
                                                           target="_blank"
                                                           class="btn btn-sm btn-outline-primary">
                                                            Edit
                                                        </a>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            <div class="row">
                                <div class="col-md text-md-end text-sm-right small mb-1">
                                    @(Model.UserEvents.Where(f => f.CompletionDate != null).Count() > 0 ? $"Total Completed Events: {Model.UserEvents.Where(f => f.CompletionDate != null).Count()}" : "")
                                </div>
                            </div>
                            @if (Model.UserEvents.Where(f => f.CompletionDate != null).Count() > 0)
