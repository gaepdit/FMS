                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (Model.CurrentUser.UserPosition.Name == "PM2")
    {
        <div class="accordion accordion-flush" id="Current-Program-Facilites">
            <div class="accordion-item">
                <h3 class="accordion-header" id="MyProgramFacilitiesList">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#MyProgramFacilities" aria-expanded="true" aria-controls="MyProgramFacilities">
                        <h3>My Program Facilities</h3>
                    </button>
                </h3>
                <div id="MyProgramFacilities" class="accordion-collapse collapse" aria-labelledby="MyProgramFacilitiesList">
                    <div class="accordion-body">
                        <div class="row">
                            <div class="col-8">
                                <h4>Active Facilities for Program: @Model.CurrentUser.UserProgram.Name</h4>
                            </div>
                            <div class="col-md text-md-end text-sm-right small mb-1">
                                @(Model.ProgramFacilities.Count() > 0 ? $"Total Facilities: {Model.ProgramFacilities.Count()}" : "No Facilities Assigned")
                            </div>
                        </div>
                        @foreach (var unit in Model.UserUnits)
                        {
                            <div class="accordion accordion-flush" id="Current-Facility-Work+@Model.UserUnits.IndexOf(unit)">
                                <div class="accordion-item">
                                    <h3 class="accordion-header" id="MyProgramFacilitiesList+@Model.UserUnits.IndexOf(unit)">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#MyProgramFacilities+@Model.UserUnits.IndexOf(unit)" aria-expanded="true" aria-controls="MyProgramFacilities+@Model.UserUnits.IndexOf(unit)">
                                            <h5>@unit</h5>
                                        </button>
                                    </h3>
                                    <div id="MyProgramFacilities+@Model.UserUnits.IndexOf(unit)" class="accordion-collapse collapse" aria-labelledby="MyProgramFacilitiesList+@Model.UserUnits.IndexOf(unit)">
                                        <div class="accordion-body">
                                            <div class="row">
                                                <div class="col-md text-md-end text-sm-right small mb-1">
                                                    @(Model.ProgramFacilities.Where(e => e.OrganizationalUnit?.Name == unit).Count() > 0 ? $"{Model.ProgramFacilities.Where(e => e.OrganizationalUnit?.Name == unit).Count()} out of {Model.ProgramFacilities.Count()} Total Facilities: " : "No Facilities Assigned")
                                                </div>
                                            </div>
                                            <form method="post">
                                                <table class="table" aria-label="List of Program Facilities">
                                                    <thead class="thead-light">
                                                        <tr>
                                                            <th scope="col" class="col">Number</th>
                                                            <th scope="col" class="col">Name</th>
                                                            <th scope="col" class="col">Unit</th>
                                                            <th scope="col" class="col">C.O.</th>
                                                            <th scope="col" class="col">County</th>
                                                            <th scope="col" class="col">Class</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var item in Model.ProgramFacilities.Where(e => e.OrganizationalUnit?.Name == unit))
                                                        {
                                                            <tr class="@(!item.Active ? "table-warning" : "")">
                                                                <td>
                                                                    <a asp-page="/Facilities/Details" asp-route-id="@item.Id" target="_blank" class="btn @(item.Active ? "btn-outline-info" : "btn-outline-secondary") btn-sm text-nowrap">
                                                                        @Html.DisplayFor(m => item.FacilityNumber, "StringOrNone")
                                                                    </a>
                                                                </td>
                                                                <td>
                                                                    @Html.DisplayFor(m => item.Name, "StringOrNone")
                                                                </td>
                                                                <td class="text-nowrap">
                                                                    @Html.DisplayFor(m => item.OrganizationalUnit.Name, "StringOrNone")
                                                                </td>
                                                                <td class="text-nowrap">
                                                                    @Html.DisplayFor(m => item.ComplianceOfficer.Name, "StringOrNone")
                                                                </td>
                                                                <td class="text-nowrap">
                                                                    @Html.DisplayFor(m => item.County.Name, "StringOrNone")
                                                                </td>
                                                                <td class="text-nowrap">
                                                                    @Html.DisplayFor(m => item.LocationClass.Name, "StringOrNone")
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.CurrentUser.UserPosition.Name == "PM2" && Model.Roles.Contains(UserRoles.SiteMaintenance))
