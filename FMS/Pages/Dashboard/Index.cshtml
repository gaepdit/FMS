                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#MyCOUnitEvents+@Model.UserCOs.IndexOf(co)" aria-expanded="true" aria-controls="MyCOUnitEvents+@Model.UserCOs.IndexOf(co)">
                                                <h5>@co</h5>
                                            </button>
                                        </h3>
                                        <div id="MyCOUnitEvents+@Model.UserCOs.IndexOf(co)" class="accordion-collapse collapse" aria-labelledby="MyCOUnitEventsList+@Model.UserCOs.IndexOf(co)">
                                            <div class="accordion-body">
                                                <div class="row">
                                                    <div class="col-md text-md-end text-sm-right small mb-1">
                                                        @(Model.UnitEvents.Where(e => e.ComplianceOfficer?.Name == co).Count() > 0 ? $"{Model.UnitEvents.Where(e => e.ComplianceOfficer?.Name == co).Count()} out of {Model.UnitEvents.Count()} Total Events: " : "No Events Assigned")
                                                    </div>
                                                </div>
                                                <form method="post">
                                                    <table class="table" aria-label="List of Events">
                                                        <thead class="thead-light">
                                                            <tr>
                                                                <th scope="col" class="col">Facility Number</th>
                                                                <th scope="col" class="col">Facility Name</th>
                                                                <th scope="col" class="col">Event Type</th>
                                                                <th scope="col" class="col">Action Taken</th>
                                                                <th scope="col" class="col">Start Date</th>
                                                                <th scope="col" class="col">Due Date</th>
                                                                <th scope="col" class="col">Completion Date</th>
                                                                <th scope="col" class="col">Compliance Officer</th>
                                                                <th scope="col" class="col">Comment</th>
                                                                @if (User.IsInRole(UserRoles.FileEditor) || User.IsInRole(UserRoles.ComplianceOfficer))
                                                                {
                                                                    <th scope="col" class="col">Actions</th>
                                                                }
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var item in Model.UnitEvents.Where(e => e.CompletionDate == null && e.StartDate == null && e.ComplianceOfficer?.Name == co))
                                                            {
                                                                <tr class="table-warning">
                                                                    <td>
                                                                        <a asp-page="/Facilities/Details" asp-route-id="@item.FacilityId" asp-fragment="TabPages" asp-route-tab="Events" target="_blank" class="btn @(item.Active ? "btn-outline-info" : "btn-outline-secondary") btn-sm text-nowrap">
                                                                            @Html.DisplayFor(m => item.FacilityNumber, "StringOrNone")
                                                                        </a>
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.FacilityName, "StringOrNone")
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.EventType.Name, "StringOrNone")
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.ActionTaken.Name, "StringOrNone")
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.StartDate, "DateOrNone")
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.DueDate, "DateOrNone")
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.CompletionDate, "DateOrNone")
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.ComplianceOfficer.Name, "StringOrNone")
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.Comment, "StringOrNone")
                                                                    </td>
                                                                    @if (User.IsInRole(UserRoles.FileEditor) || User.IsInRole(UserRoles.ComplianceOfficer))
                                                                    {
                                                                        <td>
                                                                            <a asp-page="/Event/Edit"
                                                                               asp-route-id="@item.Id"
                                                                               target="_blank"
                                                                               class="btn btn-sm btn-outline-primary">
                                                                                Edit
                                                                            </a>
                                                                        </td>
                                                                    }
                                                                </tr>
                                                            }
                                                            @foreach (var item in Model.UnitEvents.Where(e => e.CompletionDate == null && e.StartDate != null && e.ComplianceOfficer?.Name == co))
                                                            {
                                                                <tr class="table-light">
                                                                    <td>
                                                                        <a asp-page="/Facilities/Details" asp-route-id="@item.FacilityId" asp-fragment="TabPages" asp-route-tab="Events" target="_blank" class="btn @(item.Active ? "btn-outline-info" : "btn-outline-secondary") btn-sm text-nowrap">
                                                                            @Html.DisplayFor(m => item.FacilityNumber, "StringOrNone")
                                                                        </a>
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.FacilityName, "StringOrNone")
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.EventType.Name, "StringOrNone")
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.ActionTaken.Name, "StringOrNone")
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.StartDate, "DateOrNone")
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.DueDate, "DateOrNone")
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.CompletionDate, "DateOrNone")
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.ComplianceOfficer.Name, "StringOrNone")
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.Comment, "StringOrNone")
                                                                    </td>
                                                                    @if (User.IsInRole(UserRoles.FileEditor) || User.IsInRole(UserRoles.ComplianceOfficer))
                                                                    {
                                                                        <td>
                                                                            <a asp-page="/Event/Edit"
                                                                               asp-route-id="@item.Id"
                                                                               target="_blank"
                                                                               class="btn btn-sm btn-outline-primary">
                                                                                Edit
                                                                            </a>
                                                                        </td>
                                                                    }
                                                                </tr>
                                                            }
                                                            @foreach (var item in Model.UnitEvents.Where(e => e.CompletionDate != null && e.ComplianceOfficer?.Name == co))
                                                            {
                                                                <tr>
                                                                    <td>
                                                                        <a asp-page="/Facilities/Details" asp-route-id="@item.FacilityId" asp-fragment="TabPages" asp-route-tab="Events" target="_blank" class="btn @(item.Active ? "btn-outline-info" : "btn-outline-secondary") btn-sm text-nowrap">
                                                                            @Html.DisplayFor(m => item.FacilityNumber, "StringOrNone")
                                                                        </a>
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.FacilityName, "StringOrNone")
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.EventType.Name, "StringOrNone")
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.ActionTaken.Name, "StringOrNone")
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.StartDate, "DateOrNone")
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.DueDate, "DateOrNone")
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.CompletionDate, "DateOrNone")
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.ComplianceOfficer.Name, "StringOrNone")
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(m => item.Comment, "StringOrNone")
                                                                    </td>
                                                                    @if (User.IsInRole(UserRoles.FileEditor) || User.IsInRole(UserRoles.ComplianceOfficer))
                                                                    {
                                                                        <td>
                                                                            <a asp-page="/Event/Edit"
                                                                               asp-route-id="@item.Id"
                                                                               target="_blank"
                                                                               class="btn btn-sm btn-outline-primary">
                                                                                Edit
                                                                            </a>
                                                                        </td>
                                                                    }
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    @if (Model.CurrentUser.UserPosition.Name == "PM2")
    {
        <div class="accordion accordion-flush" id="Current-Events-Work">
            <div class="accordion-item">
                <h3 class="accordion-header" id="MyProgramEventsList">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#MyProgramEvents" aria-expanded="true" aria-controls="MyProgramEvents">
                        <h3>My Program Events</h3>
                    </button>
                </h3>
                <div id="MyProgramEvents" class="accordion-collapse collapse" aria-labelledby="MyProgramEventsList">
                    <div class="accordion-body">
                        <div class="row">
                            <div class="col-8">
                                <h4>Active Events for Program: @Model.CurrentUser.UserProgram.Name</h4>
                            </div>
                            <div class="col-md text-md-end text-sm-right small mb-1">
                                @(Model.ProgramEvents.Count() > 0 ? $"Total Events: {Model.ProgramEvents.Count()}" : "No Events Assigned")
                            </div>
                        </div>
                        @foreach (var unit in Model.UserUnits)
                        {
                            <div class="accordion accordion-flush" id="Current-Events-Work+@Model.UserUnits.IndexOf(unit)">
                                <div class="accordion-item">
                                    <h3 class="accordion-header" id="MyProgramEventsList+@Model.UserUnits.IndexOf(unit)">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#MyProgramEvents+@Model.UserUnits.IndexOf(unit)" aria-expanded="true" aria-controls="MyProgramEvents+@Model.UserUnits.IndexOf(unit)">
                                            <h5>@unit</h5>
                                        </button>
                                    </h3>
                                    <div id="MyProgramEvents+@Model.UserUnits.IndexOf(unit)" class="accordion-collapse collapse" aria-labelledby="MyProgramEventsList+@Model.UserUnits.IndexOf(unit)">
                                        <div class="accordion-body">
                                            <div class="row">
                                                <div class="col-md text-md-end text-sm-right small mb-1">
                                                    @(Model.ProgramEvents.Where(e => e.Unit?.Name == unit).Count() > 0 ? $"{Model.ProgramEvents.Where(e => e.Unit?.Name == unit).Count()} out of {Model.ProgramEvents.Count()} Total Events: " : "No Events Assigned")
                                                </div>
                                            </div>
                                            @foreach (var co in Model.UserCOs)
                                            {
                                                if (Model.ProgramEvents.Where(e => e.ComplianceOfficer?.Name == co && e.Unit?.Name == unit).Count() > 0)
                                                {
                                                    <div class="accordion accordion-flush" id="Current-CO-Events-Work+@Model.UserUnits.IndexOf(unit)+@Model.UserCOs.IndexOf(co)">
                                                        <div class="accordion-item">
                                                            <h3 class="accordion-header" id="MyCOProgramEventsList+@Model.UserUnits.IndexOf(unit)+@Model.UserCOs.IndexOf(co)">
                                                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#MyCOProgramEvents+@Model.UserUnits.IndexOf(unit)+@Model.UserCOs.IndexOf(co)" aria-expanded="true" aria-controls="MyCOProgramEvents+@Model.UserUnits.IndexOf(unit)+@Model.UserCOs.IndexOf(co)">
                                                                    <h5>@co</h5>
                                                                </button>
                                                            </h3>
                                                            <div id="MyCOProgramEvents+@Model.UserUnits.IndexOf(unit)+@Model.UserCOs.IndexOf(co)" class="accordion-collapse collapse" aria-labelledby="MyCOProgramEventsList+@Model.UserUnits.IndexOf(unit)+@Model.UserCOs.IndexOf(co)">
                                                                <div class="accordion-body">
                                                                    <div class="row">
                                                                        <div class="col-md text-md-end text-sm-right small mb-1">
                                                                            @(Model.ProgramEvents.Where(e => e.ComplianceOfficer?.Name == co && e.Unit?.Name == unit).Count() > 0 ? $"{Model.ProgramEvents.Where(e => e.ComplianceOfficer?.Name == co && e.Unit?.Name == unit).Count()} out of {Model.ProgramEvents.Count()} Total Events: " : "No Events Assigned")
                                                                        </div>
                                                                    </div>
                                                                    <form method="post">
                                                                        <table class="table" aria-label="List of Events">
                                                                            <thead class="thead-light">
                                                                                <tr>
                                                                                    <th scope="col" class="col">Facility Number</th>
                                                                                    <th scope="col" class="col">Facility Name</th>
                                                                                    <th scope="col" class="col">Event Type</th>
                                                                                    <th scope="col" class="col">Action Taken</th>
                                                                                    <th scope="col" class="col">Start Date</th>
                                                                                    <th scope="col" class="col">Due Date</th>
                                                                                    <th scope="col" class="col">Compl. Date</th>
                                                                                    <th scope="col" class="col">C. O.</th>
                                                                                    <th scope="col" class="col">Comment</th>
                                                                                    @if (User.IsInRole(UserRoles.FileEditor) || User.IsInRole(UserRoles.ComplianceOfficer))
                                                                                    {
                                                                                        <th scope="col" class="col">Actions</th>
                                                                                    }
                                                                                </tr>
                                                                            </thead>
                                                                            <tbody>
                                                                                @foreach (var item in Model.ProgramEvents.Where(e => e.ComplianceOfficer?.Name == co && e.Unit?.Name == unit &&  e.CompletionDate == null && e.StartDate == null))
                                                                                {
                                                                                    <tr class="table-warning">
                                                                                        <td>
                                                                                            <a asp-page="/Facilities/Details" asp-route-id="@item.FacilityId" asp-fragment="TabPages" asp-route-tab="Events" target="_blank" class="btn @(item.Active ? "btn-outline-info" : "btn-outline-secondary") btn-sm">
                                                                                                @Html.DisplayFor(m => item.FacilityNumber, "StringOrNone")
                                                                                            </a>
                                                                                        </td>
                                                                                        <td>
                                                                                            @Html.DisplayFor(m => item.FacilityName, "StringOrNone")
                                                                                        </td>
                                                                                        <td>
                                                                                            @Html.DisplayFor(m => item.EventType.Name, "StringOrNone")
                                                                                        </td>
                                                                                        <td>
                                                                                            @Html.DisplayFor(m => item.ActionTaken.Name, "StringOrNone")
                                                                                        </td>
                                                                                        <td>
                                                                                            @Html.DisplayFor(m => item.StartDate, "DateOrNone")
                                                                                        </td>
                                                                                        <td>
                                                                                            @Html.DisplayFor(m => item.DueDate, "DateOrNone")
                                                                                        </td>
                                                                                        <td>
                                                                                            @Html.DisplayFor(m => item.CompletionDate, "DateOrNone")
                                                                                        </td>
                                                                                        <td>
                                                                                            @Html.DisplayFor(m => item.ComplianceOfficer.Name, "StringOrNone")
                                                                                        </td>
                                                                                        <td>
                                                                                            @Html.DisplayFor(m => item.Comment, "StringOrNone")
                                                                                        </td>
                                                                                        @if (User.IsInRole(UserRoles.FileEditor) || User.IsInRole(UserRoles.SiteMaintenance))
                                                                                        {
                                                                                            <td>
                                                                                                <a asp-page="/Event/Edit"
                                                                                                   asp-route-id="@item.Id"
                                                                                                   target="_blank"
                                                                                                   class="btn btn-sm btn-outline-primary">
                                                                                                    Edit
                                                                                                </a>
                                                                                                @if (User.IsInRole(UserRoles.SiteMaintenance))
                                                                                                {
                                                                                                    <a asp-page="/Event/Delete"
                                                                                                       asp-route-id="@item.Id"
                                                                                                       target="_blank"
                                                                                                       class="btn btn-sm btn-outline-danger">
                                                                                                        Delete
                                                                                                    </a>
