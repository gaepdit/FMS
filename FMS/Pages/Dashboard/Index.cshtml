                                            <tr class="table-warning">
                                                <td>
                                                    <a asp-page="/Facilities/Details" asp-route-id="@item.FacilityId" asp-fragment="TabPages" asp-route-tab="Events" target="_blank" class="btn @(item.Active ? "btn-outline-info" : "btn-outline-secondary") btn-sm text-nowrap">
                                                        @Html.DisplayFor(m => item.FacilityNumber, "StringOrNone")
                                                    </a>
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(m => item.FacilityName, "StringOrNone")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(m => item.EventType.Name, "StringOrNone")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(m => item.ActionTaken.Name, "StringOrNone")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(m => item.StartDate, "DateOrNone")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(m => item.DueDate, "DateOrNone")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(m => item.CompletionDate, "DateOrNone")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(m => item.OrganizationalUnit.Name, "StringOrNone")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(m => item.Comment, "StringOrNone")
                                                </td>
