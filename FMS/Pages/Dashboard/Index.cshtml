                                @(Model.UnitEvents.Count() > 0 ? $"Total Events: {Model.UnitEvents.Count()}" : "No Events Assigned")
                            </div>
                        </div>
                        @foreach (var co in Model.UserCOs)
                        {
                            if (Model.UnitEvents.Where(e => e.ComplianceOfficer?.Name == co).Count() > 0)
                            {
