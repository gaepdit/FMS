<div class="container bg-light-subtle p-1 m-1 rounded-3">
    @if (Model.CurrentUser.UserPosition.Name != "PM2")
    {
        <div class="accordion accordion-flush" id="Current-User-Facilites">
            <div class="accordion-item">
                <div class="row">
                    <div class="col">
                        <h3 class="accordion-header" id="MyFacilityList">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#MyFacilities" aria-expanded="true" aria-controls="MyFacilities">
                                <h3>My Facilities</h3>
                            </button>
                        </h3>
                    </div>
                </div>
                <div id="MyFacilities" class="accordion-collapse collapse" aria-labelledby="MyFacilityList">
                    <div class="accordion-body">
                        <form method="post">
                            <table class="table" aria-label="List of User Facilities">
                                <div class="row">
                                    <div class="col-8">
                                        <h4>Facilities for Compliance Officer: @Model.CurrentUser.DisplayName</h4>
                                    </div>
                                    <div class="col-md text-md-end text-sm-right small mb-1">
                                        @(Model.UserFacilities.Count() > 0 ? $"Total Facilities: {Model.UserFacilities.Count()}" : "No Facilities Assigned")
                                    </div>
                                </div>
                                <thead class="thead-light">
                                    <tr>
                                        <th scope="col" class="col">Number</th>
                                        <th scope="col" class="col">Name</th>
                                        <th scope="col" class="col">Unit</th>
                                        <th scope="col" class="col">County</th>
                                        <th scope="col" class="col">Class</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.UserFacilities)
                                    {
                                        <tr class="@(!item.Active ? "table-warning" : "")">
                                            <td>
                                                <a asp-page="/Facilities/Details" asp-route-id="@item.Id" target="_blank" class="btn @(item.Active ? "btn-outline-info" : "btn-outline-secondary") btn-sm text-nowrap">
                                                    @Html.DisplayFor(m => item.FacilityNumber, "StringOrNone")
                                                </a>
                                            </td>
                                            <td>
                                                @Html.DisplayFor(m => item.Name, "StringOrNone")
                                            </td>
                                            <td class="text-nowrap">
                                                @Html.DisplayFor(m => item.OrganizationalUnit.Name, "StringOrNone")
                                            </td>
                                            <td class="text-nowrap">
                                                @Html.DisplayFor(m => item.County.Name, "StringOrNone")
                                            </td>
                                            <td class="text-nowrap">
                                                @Html.DisplayFor(m => item.LocationClass.Name, "StringOrNone")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (Model.CurrentUser.UserPosition.Name == "PM1")
    {
        <div class="accordion accordion-flush" id="Current-Unit-Facilities">
            <div class="accordion-item">
                <h3 class="accordion-header" id="MyUnitFacilityList">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#MyUnitFacilities" aria-expanded="true" aria-controls="MyUnitFacilities">
                        <h3>My Unit Facilities</h3>
                    </button>
                </h3>
                <div id="MyUnitFacilities" class="accordion-collapse collapse" aria-labelledby="MyUnitFacilityList">
                    <div class="accordion-body">
                        <form method="post">
                            <table class="table" aria-label="List of Unit Facilities">
                                <div class="row">
                                    <div class="col-8">
                                        <h4>Active Facilities for Unit: @Model.CurrentUser.UserUnit.Name</h4>
                                    </div>
                                    <div class="col-md text-md-end text-sm-right small mb-1">
                                        @(Model.UnitFacilities.Count() > 0 ? $"Total Facilities: {Model.UnitFacilities.Count()}" : "No Facilities Assigned")
                                    </div>
                                </div>
                                <thead class="thead-light">
                                    <tr>
                                        <th scope="col" class="col">Number</th>
                                        <th scope="col" class="col">Name</th>
                                        <th scope="col" class="col">C.O.</th>
                                        <th scope="col" class="col">County</th>
                                        <th scope="col" class="col">Class</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.UnitFacilities)
                                    {
                                        <tr class="@(!item.Active ? "table-warning" : "")">
                                            <td>
                                                <a asp-page="/Facilities/Details" asp-route-id="@item.Id" target="_blank" class="btn @(item.Active ? "btn-outline-info" : "btn-outline-secondary") btn-sm text-nowrap">
                                                    @Html.DisplayFor(m => item.FacilityNumber, "StringOrNone")
                                                </a>
                                            </td>
                                            <td>
                                                @Html.DisplayFor(m => item.Name, "StringOrNone")
                                            </td>
                                            <td class="text-nowrap">
                                                @Html.DisplayFor(m => item.ComplianceOfficer.Name, "StringOrNone")
                                            </td>
                                            <td class="text-nowrap">
                                                @Html.DisplayFor(m => item.County.Name, "StringOrNone")
                                            </td>
                                            <td class="text-nowrap">
                                                @Html.DisplayFor(m => item.LocationClass.Name, "StringOrNone")
